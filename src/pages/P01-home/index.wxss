/* P01 首页 — PANR-19 C5 (v3.2 sync · 3-tab)
 * 视觉对齐：issue 附件 p01-home.html (v3.2)
 * 所有 px 值按 375rpx 设计宽度换算 (1px = 2rpx)
 */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 160rpx; /* 留出 tabbar 高度 (64px = 128rpx + 安全区) */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
  box-sizing: border-box;
}

/* ===== Top search (替代传统 NavBar) ===== */
.topbar {
  padding: 16rpx 32rpx 24rpx; /* 8px 16px 12px → 16rpx 32rpx 24rpx */
  background: #FFFFFF;
}

.search-bar {
  height: 72rpx; /* 36px → 72rpx */
  background: #F2F3F5;
  border-radius: 36rpx; /* 18px → 36rpx */
  padding: 0 28rpx; /* 14px → 28rpx */
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px → 16rpx */
  box-sizing: border-box;
}

.search-bar--hover {
  background: #E5E6EB;
}

.search-bar__icon {
  color: #86909C;
  font-size: 28rpx; /* 14px → 28rpx */
}

.search-bar__placeholder {
  font-size: 26rpx; /* 13px → 26rpx */
  color: #86909C;
}

/* ===== Banner 推荐位 ===== */
.banner-area {
  padding: 24rpx 32rpx 8rpx; /* 12px 16px 4px → 24rpx 32rpx 8rpx */
}

.banner {
  height: 192rpx; /* 96px → 192rpx */
  border-radius: 24rpx; /* 12px → 24rpx */
  padding: 28rpx 32rpx; /* 14px 16px → 28rpx 32rpx */
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.banner__tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 22rpx; /* 11px → 22rpx */
  padding: 4rpx 16rpx; /* 2px 8px → 4rpx 16rpx */
  border-radius: 8rpx; /* 4px → 8rpx */
  background: rgba(255, 255, 255, 0.18);
  letter-spacing: 1rpx;
}

.banner__title {
  font-size: 32rpx; /* 16px → 32rpx */
  font-weight: 600;
  line-height: 1.3;
  margin-top: 8rpx;
}

.banner__sub {
  font-size: 24rpx; /* 12px → 24rpx */
  opacity: 0.85;
  line-height: 1.4;
  margin-top: 4rpx;
}

/* ===== Dots ===== */
.dots {
  display: flex;
  justify-content: center;
  gap: 8rpx; /* 4px → 8rpx */
  margin-top: 16rpx; /* 8px → 16rpx */
}

.dots__dot {
  width: 10rpx; /* 5px → 10rpx */
  height: 10rpx;
  border-radius: 50%;
  background: #C9CDD4;
}

.dots__dot--active {
  width: 28rpx; /* 14px → 28rpx */
  border-radius: 6rpx; /* 3px → 6rpx */
  background: #1677FF;
}

/* ===== Section label ===== */
.section-label {
  font-size: 26rpx; /* 13px → 26rpx */
  color: #4E5969;
  font-weight: 500;
  margin: 24rpx 8rpx 16rpx; /* 12px 4px 8px → 24rpx 8rpx 16rpx */
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx; /* 16px → 32rpx */
}

.section-label__more {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #86909C;
  font-weight: 400;
}

/* ===== Category grid (2 行 × 4 列) ===== */
.cat-grid {
  background: #FFFFFF;
  border-radius: 32rpx; /* 16px → 32rpx */
  margin: 0 32rpx; /* 16px → 32rpx */
  padding: 28rpx 8rpx; /* 14px 4px → 28rpx 8rpx */
  border: 1rpx solid #E5E6EB;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 24rpx; /* 12px → 24rpx */
  box-sizing: border-box;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx; /* 6px → 12rpx */
  cursor: pointer;
  padding: 12rpx 0; /* 视觉舒适 */
}

.cat-item--hover {
  opacity: 0.7;
}

.cat-icon {
  width: 80rpx; /* 40px → 80rpx */
  height: 80rpx;
  border-radius: 20rpx; /* 10px → 20rpx */
  background: #F0F5FF;
  color: #1677FF;
  font-size: 36rpx; /* 18px → 36rpx */
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-name {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #4E5969;
}

/* ===== Featured goods (2 列卡片) ===== */
.goods-grid {
  margin: 0 32rpx; /* 16px → 32rpx */
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx; /* 12px → 24rpx */
  padding-bottom: 24rpx;
}

.goods-card {
  background: #FFFFFF;
  border-radius: 24rpx; /* 12px → 24rpx */
  overflow: hidden;
  border: 1rpx solid #E5E6EB;
  box-sizing: border-box;
}

.goods-card--hover {
  opacity: 0.85;
}

.goods-cover {
  height: 200rpx; /* 100px → 200rpx */
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-cover__label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 36rpx; /* 18px → 36rpx */
  font-weight: 600;
  letter-spacing: 1rpx;
}

.goods-meta {
  padding: 20rpx 24rpx 24rpx; /* 10px 12px 12px → 20rpx 24rpx 24rpx */
}

.goods-name {
  font-size: 26rpx; /* 13px → 26rpx */
  font-weight: 500;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-sub {
  font-size: 22rpx; /* 11px → 22rpx */
  color: #86909C;
  margin-top: 6rpx; /* 3px → 6rpx */
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-price {
  font-size: 28rpx; /* 14px → 28rpx */
  font-weight: 600;
  color: #1D2129;
  margin-top: 12rpx; /* 6px → 12rpx */
}

.goods-price__unit {
  font-size: 22rpx; /* 11px → 22rpx */
  font-weight: 400;
  color: #86909C;
  margin-left: 2rpx;
}

/* ===== Bottom Tab Bar (v3.2 · 3 tab) ===== */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 128rpx; /* 64px → 128rpx (375px 屏) */
  background: #FFFFFF;
  border-top: 1rpx solid #F0F1F3;
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* v3.2 · 4 列改 3 列 */
  align-items: center;
  padding-bottom: 16rpx; /* 8px → 16rpx (home indicator) */
  box-sizing: border-box;
  z-index: 50;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx; /* 2px → 4rpx */
  color: #86909C;
  font-size: 22rpx; /* 11px → 22rpx */
  min-height: 88rpx; /* 满足 tap 标准 */
  justify-content: center;
}

.tab__glyph {
  font-size: 40rpx; /* 20px → 40rpx */
  line-height: 1;
}

.tab--active {
  color: #1677FF;
}