/* P04 订单确认页 — 高保真样式（对齐 p04.html）
 * 全屏背景 #F7F8FA；卡片白底 16rpx 圆角 + 1px #E5E6EB 边框
 * tier row 64px 高 + 选中蓝底 #F0F5FF + 左侧 inset 3px #1677FF 阴影
 * warn banner #FFF4E5 底 + 8px #FF7D00 圆点
 * 协议勾选框 18×18 + 选中后 1677FF 蓝 + 内白勾
 * 提交按钮 48px 高 + 16rpx 圆角 + 灰底 #E5E6EB（始终 disabled）
 */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 140rpx; /* 留出 footer 高度 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

/* Nav bar */
.nav {
  height: 52px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F7F8FA;
}

.nav .back {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 500;
  color: #1D2129;
}

.nav .title {
  font-size: 16px;
  font-weight: 500;
  color: #1D2129;
}

.nav .right {
  width: 32px;
}

/* Content */
.content {
  padding: 4px 16px 16px;
}

/* Header card */
.header-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 14px;
  display: flex;
  gap: 12px;
  align-items: center;
  border: 1px solid #E5E6EB;
}

.header-card .cover {
  width: 72px;
  height: 72px;
  border-radius: 12px;
  background: linear-gradient(135deg, #1677FF 0%, #0A47A0 100%);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.header-card .cover::after {
  content: "SaaS";
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.header-card .info {
  flex: 1;
  min-width: 0;
}

.header-card .name {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 4px;
  word-break: break-all;
}

.header-card .subtitle {
  font-size: 12px;
  color: #86909C;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Section label */
.section-label {
  font-size: 13px;
  color: #4E5969;
  font-weight: 500;
  margin: 16px 4px 8px;
}

/* Tier list */
.tier-list {
  background: #FFFFFF;
  border-radius: 16px;
  border: 1px solid #E5E6EB;
  overflow: hidden;
}

.tier-row {
  height: 64px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid #F2F3F5;
}

.tier-row:last-child {
  border-bottom: none;
}

.tier-row.selected {
  background: #F0F5FF;
  box-shadow: inset 3px 0 0 #1677FF;
  padding-left: 11px;
}

.tier-row .badge {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: #F2F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  color: #4E5969;
  flex-shrink: 0;
}

.tier-row.selected .badge {
  background: #1677FF;
  color: #FFFFFF;
}

.tier-row .meta {
  flex: 1;
  min-width: 0;
}

.tier-row .name {
  font-size: 14px;
  font-weight: 500;
  line-height: 1.3;
}

.tier-row .duration {
  font-size: 12px;
  color: #86909C;
  margin-top: 2px;
}

.tier-row .price {
  font-size: 15px;
  font-weight: 600;
  color: #1D2129;
  flex-shrink: 0;
}

.tier-row .check {
  width: 18px;
  height: 18px;
  border: 1.5px solid #C9CDD4;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}

.tier-row.selected .check {
  border-color: #1677FF;
  background: #1677FF;
}

.tier-row.selected .check::after {
  content: "";
  position: absolute;
  left: 4px;
  top: 1px;
  width: 5px;
  height: 9px;
  border: solid #FFFFFF;
  border-width: 0 1.5px 1.5px 0;
  transform: rotate(45deg);
}

/* Banner — Warning variant */
.banner {
  margin-top: 12px;
  background: #FFF4E5;
  border-radius: 12px;
  padding: 12px 14px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.banner .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #FF7D00;
  margin-top: 6px;
  flex-shrink: 0;
}

.banner .text {
  font-size: 13px;
  line-height: 1.5;
  color: #FF7D00;
}

/* Agreement row */
.agreement {
  margin-top: 8px;
  min-height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 4px;
}

.checkbox {
  width: 18px;
  height: 18px;
  border: 1.5px solid #C9CDD4;
  border-radius: 4px;
  flex-shrink: 0;
  background: #FFFFFF;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  border-color: #1677FF;
  background: #1677FF;
}

.checkbox__mark {
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
}

.agreement .text {
  font-size: 13px;
  color: #4E5969;
  line-height: 1.4;
}

.agreement .text .link {
  color: #1677FF;
}

/* Footer */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14px 16px 28px;
  background: #FFFFFF;
  border-top: 1px solid #F0F1F3;
}

.btn-primary {
  width: 100%;
  height: 48px;
  background: #E5E6EB;
  color: #FFFFFF;
  border: none;
  border-radius: 16px;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.5px;
}

.btn-primary[disabled] {
  background: #E5E6EB;
  color: #FFFFFF;
}