/* P04 订单确认页 — page-specific styles
 * .banner* 已在 global.wxss，本文件只补 card / footer / btn
 */

.page {
  padding: 0 0 200rpx 0;
}

.card {
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.card__label {
  color: #86909c;
  font-size: 26rpx;
}

.card__value {
  color: #1f2329;
  font-size: 28rpx;
}

.card__value--price {
  color: #f53f3f;
  font-weight: 600;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn--primary {
  background: #1f2329;
  color: #ffffff;
}