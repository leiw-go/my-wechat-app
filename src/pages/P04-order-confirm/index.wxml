<!-- P04 订单确认页 — PANR-19 C5 high-fidelity
     视觉对齐 issue 附件 p04.html（v2 已 P04 单独 sign-off, 2026-08-30T10:55）
     数据：MVP demo 数据硬编码（无后端依赖）；按 PRD §6.1 商品表 + §6.2 档位表
     状态：loadState='ready'（首屏默认；onLoad 可被 query 预填）
     按钮：始终 disabled 视觉（灰底 #E5E6EB）；onSubmit 早返 toast 与 5030 对齐 -->
<view class="page">
  <!--
    顶部 title 由 src/pages/P04-order-confirm/index.json 的 navigationBarTitleText
    ("订单确认") 渲染为 WeChat 系统导航栏；不在 WXML 内重复自定义 .nav 块，
    避免视觉上「订单确认」+「确认订单」两行重复（dispatch §coordinator fix 2026-08-30）。
  -->

  <view class="content">
    <!-- Header card -->
    <view class="header-card">
      <view class="cover"></view>
      <view class="info">
        <view class="name">{{goods.name}}</view>
        <view class="subtitle">{{goods.subtitle}}</view>
      </view>
    </view>

    <!-- Section label -->
    <view class="section-label">选择档位</view>

    <!-- Tier vertical list -->
    <view class="tier-list">
      <view
        wx:for="{{tiers}}"
        wx:key="code"
        class="tier-row {{item.code === selectedTier ? 'selected' : ''}}"
        bindtap="onTapTier"
        data-code="{{item.code}}"
      >
        <view class="badge">{{item.code}}</view>
        <view class="meta">
          <view class="name">{{item.name}}</view>
          <view class="duration">{{item.duration}}</view>
        </view>
        <view class="price">¥{{item.price}}</view>
        <view class="check"></view>
      </view>
    </view>

    <!-- Banner: Warning variant -->
    <view class="banner warn">
      <view class="dot"></view>
      <view class="text">支付功能未启用 · 按钮标注「未上线」</view>
    </view>

    <!-- Agreement row -->
    <view class="agreement" bindtap="onToggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="checkbox__mark">✓</text>
      </view>
      <view class="text">我已阅读并同意<text class="link">《会员服务协议》</text></view>
    </view>

    <!-- Footer button (pinned) -->
    <view class="footer">
      <button
        class="btn-primary {{agreed ? 'agreed' : ''}}"
        disabled="{{true}}"
        bindtap="onSubmit"
      >提交订单（未上线）</button>
    </view>
  </view>
</view>