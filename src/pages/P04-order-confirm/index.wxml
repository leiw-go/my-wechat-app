<!-- P04 订单确认页 — PANR-19 C5 high-fidelity (P0 组件化)
     重构后：所有结构件改用 P0 组件（ADR-007 §二方案 3）
       - goods-header-card 商品头卡
       - tier-list 档位列表
       - banner (tone='warn') 提示
       - agreement-row 协议勾选行
       - action-footer 底部固定区
     页面 .wxss 仅保留 page padding / content padding / 间距微调
     系统 nav 由 index.json navigationBarTitleText "订单确认" 渲染 -->
<view class="page">
  <view class="content">
    <!-- Header card -->
    <goods-header-card
      name="{{goods.name}}"
      subtitle="{{goods.subtitle}}"
      subtitle-tone="gray"
    />

    <!-- Section label -->
    <view class="section-label">选择档位</view>

    <!-- Tier list -->
    <tier-list
      tiers="{{tiers}}"
      selected-code="{{selectedTier}}"
      bind:select="onTapTier"
    />

    <!-- Banner: Warning -->
    <banner tone="warn" text="支付功能未启用 · 按钮标注「未上线」" />

    <!-- Agreement row -->
    <agreement-row
      checked="{{agreed}}"
      text="我已阅读并同意"
      link-text="《会员服务协议》"
      bind:change="onAgreementChange"
    />

    <!-- Footer -->
    <action-footer single="{{true}}">
      <view slot="primary">
        <button
          class="btn-primary {{agreed ? 'btn-primary--agreed' : ''}}"
          disabled="{{true}}"
          bindtap="onSubmit"
        >提交订单（未上线）</button>
      </view>
    </action-footer>
  </view>
</view>