/* P12 售后 / 服务协议页 — high-fidelity (P0 组件化后)
 * 移除 inline .footer + .btn-primary（已抽 action-footer）
 * 移除 inline .banner--warn（已抽 banner 组件）
 * 保留页面专属：mode-bar / apply-card / contact-btn / section-label / faq-list / agreement */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 200rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

/* Mode tab */
.mode-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F1F3;
  padding: 0 16rpx;
  display: flex;
  gap: 24rpx;
  box-sizing: border-box;
}

.mode {
  font-size: 14px;
  color: #4E5969;
  padding: 14rpx 0 12rpx;
  position: relative;
}

.mode--active {
  color: #1677FF;
  font-weight: 600;
}

.mode--active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 24rpx;
  height: 3rpx;
  background: #1677FF;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

/* Content (after-sales mode) */
.content {
  padding: 16rpx 16rpx 16rpx;
  box-sizing: border-box;
}

/* Apply card */
.apply-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 18rpx;
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-bottom: 12rpx;
  border: 1rpx solid #E5E6EB;
  box-sizing: border-box;
}

.apply-card--hover {
  background: #F7F8FA;
}

.apply-card__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #E8F3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.apply-card__info {
  flex: 1;
  min-width: 0;
}

.apply-card__title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4rpx;
  line-height: 1.3;
}

.apply-card__desc {
  font-size: 12px;
  color: #86909C;
  line-height: 1.4;
}

.apply-card__arrow {
  font-size: 18px;
  color: #C9CDD4;
  flex-shrink: 0;
}

/* Contact button */
.contact-btn {
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
  border-radius: 16rpx;
  padding: 14rpx;
  text-align: center;
  font-size: 14px;
  color: #1677FF;
  font-weight: 500;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.contact-btn--hover {
  background: #F7F8FA;
}

/* Section label */
.section-label {
  font-size: 13px;
  color: #4E5969;
  font-weight: 500;
  margin: 4rpx 4rpx 8rpx;
}

/* FAQ list */
.faq-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.faq-row {
  padding: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #F2F3F5;
  box-sizing: border-box;
}

.faq-row:last-child {
  border-bottom: none;
}

.faq-row--hover {
  background: #F7F8FA;
}

.faq-row__q {
  font-size: 14px;
  color: #1D2129;
  flex: 1;
}

.faq-row__arrow {
  font-size: 14px;
  color: #C9CDD4;
  flex-shrink: 0;
}

/* 主按钮 (action-footer slot 内) */
.btn-primary {
  width: 100%;
  height: 48rpx;
  background: #E5E6EB;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.5px;
  line-height: 48rpx;
  margin: 0;
}

.btn-primary[disabled] {
  background: #E5E6EB;
  color: #FFFFFF;
}

/* Agreement mode */
.agreement {
  margin: 16rpx;
  padding: 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  box-sizing: border-box;
}

.agreement__title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1D2129;
  text-align: center;
}

.agreement__body {
  font-size: 13px;
  line-height: 1.7;
  color: #1D2129;
}

.agreement__section {
  margin-bottom: 12rpx;
}

.agreement__h {
  display: block;
  font-weight: 600;
  margin-bottom: 4rpx;
  color: #1D2129;
}

.agreement__p {
  display: block;
  color: #4E5969;
}

.agreement__ellipsis {
  text-align: center;
  font-size: 16px;
  color: #C9CDD4;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}