/* P12 售后 / 服务协议页 — high-fidelity (P0 组件化后)
 * 移除 inline .footer + .btn-primary（已抽 action-footer）
 * 移除 inline .banner--warn（已抽 banner 组件）
 * 保留页面专属：mode-bar / apply-card / contact-btn / section-label / faq-list / agreement */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 240rpx; /* 200rpx → 240rpx (action-footer 现约 220rpx 高 + home indicator 安全区) */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

/* Mode tab */
.mode-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F1F3;
  padding: 0 32rpx; /* 16rpx → 32rpx */
  display: flex;
  gap: 48rpx; /* 24rpx → 48rpx */
  box-sizing: border-box;
}

.mode {
  font-size: 28rpx; /* 14px → 28rpx */
  color: #4E5969;
  padding: 28rpx 0 24rpx; /* 14rpx 0 12rpx → 28rpx 0 24rpx (满足 88rpx tap area) */
  position: relative;
}

.mode--active {
  color: #1677FF;
  font-weight: 600;
}

.mode--active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 48rpx; /* 24px → 48rpx */
  height: 6rpx; /* 3px → 6rpx */
  background: #1677FF;
  border-radius: 4rpx;
  transform: translateX(-50%);
}

/* Content (after-sales mode) */
.content {
  padding: 32rpx; /* 16rpx → 32rpx */
  box-sizing: border-box;
}

/* Apply card */
.apply-card {
  background: #FFFFFF;
  border-radius: 32rpx; /* 16rpx → 32rpx */
  padding: 36rpx; /* 18rpx → 36rpx */
  display: flex;
  gap: 28rpx; /* 14rpx → 28rpx */
  align-items: center;
  margin-bottom: 24rpx; /* 12rpx → 24rpx */
  border: 1rpx solid #E5E6EB;
  box-sizing: border-box;
  min-height: 112rpx; /* 满足 88rpx tap area */
}

.apply-card--hover {
  background: #F7F8FA;
}

.apply-card__icon {
  width: 80rpx; /* 48rpx → 80rpx */
  height: 80rpx;
  border-radius: 24rpx; /* 14rpx → 24rpx */
  background: #E8F3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx; /* 22px → 40rpx */
  flex-shrink: 0;
}

.apply-card__info {
  flex: 1;
  min-width: 0;
}

.apply-card__title {
  font-size: 30rpx; /* 15px → 30rpx */
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.apply-card__desc {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #86909C;
  line-height: 1.4;
}

.apply-card__arrow {
  font-size: 36rpx; /* 18px → 36rpx */
  color: #C9CDD4;
  flex-shrink: 0;
}

/* Contact button */
.contact-btn {
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
  border-radius: 32rpx; /* 16rpx → 32rpx */
  padding: 28rpx; /* 14rpx → 28rpx */
  text-align: center;
  font-size: 30rpx; /* 14px → 30rpx */
  color: #1677FF;
  font-weight: 500;
  margin-bottom: 32rpx; /* 16rpx → 32rpx */
  box-sizing: border-box;
  min-height: 88rpx; /* 满足 tap 标准 */
}

.contact-btn--hover {
  background: #F7F8FA;
}

/* Section label */
.section-label {
  font-size: 26rpx; /* 13px → 26rpx */
  color: #4E5969;
  font-weight: 500;
  margin: 8rpx 8rpx 16rpx; /* 4rpx 4rpx 8rpx → 8rpx 8rpx 16rpx */
}

/* FAQ list */
.faq-list {
  background: #FFFFFF;
  border-radius: 32rpx; /* 16rpx → 32rpx */
  border: 1rpx solid #E5E6EB;
  overflow: hidden;
  margin-bottom: 32rpx; /* 16rpx → 32rpx */
}

.faq-row {
  padding: 28rpx; /* 14rpx → 28rpx */
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #F2F3F5;
  box-sizing: border-box;
  min-height: 88rpx; /* tap 标准 */
}

.faq-row:last-child {
  border-bottom: none;
}

.faq-row--hover {
  background: #F7F8FA;
}

.faq-row__q {
  font-size: 28rpx; /* 14px → 28rpx */
  color: #1D2129;
  flex: 1;
}

.faq-row__arrow {
  font-size: 28rpx; /* 14px → 28rpx */
  color: #C9CDD4;
  flex-shrink: 0;
}

/* 主按钮 (action-footer slot 内) */
.btn-primary {
  width: 100%;
  height: 96rpx; /* 48rpx → 96rpx (action-footer 已统一处理，此处 fallback) */
  background: #E5E6EB;
  color: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  font-size: 30rpx; /* 15px → 30rpx */
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 96rpx;
  margin: 0;
}

.btn-primary[disabled] {
  background: #E5E6EB;
  color: #FFFFFF;
}

/* Agreement mode */
.agreement {
  margin: 32rpx; /* 16rpx → 32rpx */
  padding: 48rpx; /* 24rpx 24rpx → 48rpx */
  background: #FFFFFF;
  border-radius: 32rpx; /* 16rpx → 32rpx */
  border: 1rpx solid #E5E6EB;
  box-sizing: border-box;
}

.agreement__title {
  font-size: 36rpx; /* 18px → 36rpx */
  font-weight: 600;
  margin-bottom: 32rpx; /* 16rpx → 32rpx */
  color: #1D2129;
  text-align: center;
}

.agreement__body {
  font-size: 26rpx; /* 13px → 26rpx */
  line-height: 1.7;
  color: #1D2129;
}

.agreement__section {
  margin-bottom: 24rpx; /* 12rpx → 24rpx */
}

.agreement__h {
  display: block;
  font-weight: 600;
  margin-bottom: 8rpx; /* 4rpx → 8rpx */
  color: #1D2129;
}

.agreement__p {
  display: block;
  color: #4E5969;
}

.agreement__ellipsis {
  text-align: center;
  font-size: 32rpx; /* 16px → 32rpx */
  color: #C9CDD4;
  margin-top: 16rpx; /* 8rpx → 16rpx */
  letter-spacing: 4rpx; /* 2rpx → 4rpx */
}