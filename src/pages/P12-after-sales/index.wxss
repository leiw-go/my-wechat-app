/* P12 售后页 — page-specific styles
 * .banner* 已在 global.wxss，本文件只补 agreement / aftersales 块
 */

.page {
  padding: 0 0 48rpx 0;
}

.agreement {
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.agreement__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.agreement__body {
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2329;
  white-space: pre-wrap;
  word-break: break-all;
}

.aftersales {
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  text-align: center;
}

.aftersales__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.aftersales__desc {
  font-size: 26rpx;
  color: #86909c;
  margin-bottom: 24rpx;
}

.btn {
  display: inline-block;
  min-width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: 1rpx solid #c9cdd4;
  background: #ffffff;
  color: #1f2329;
}