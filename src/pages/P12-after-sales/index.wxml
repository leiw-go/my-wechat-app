<!-- P12 售后 / 服务协议页 — PANR-19 C5 high-fidelity (P0 组件化)
     重构后：
       - <banner tone="warn"> 替代 inline .banner.banner--warn
       - <action-footer single=true> 替代 inline .footer + button
     保留页面专属：
       - .mode-bar (mode 切换；属 P1 候选 segmented-tabs)
       - .apply-card / .contact-btn / .faq-list / .agreement 长文
     系统 nav 由 index.json navigationBarTitleText "售后" 渲染 -->
<view class="page">
  <!-- Mode tab -->
  <view class="mode-bar">
    <view
      wx:for="{{modes}}"
      wx:key="key"
      class="mode {{mode === item.key ? 'mode--active' : ''}}"
      bindtap="onSwitchMode"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <!-- mode=after-sales -->
  <block wx:if="{{mode === 'after-sales'}}">
    <view class="content">
      <!-- Apply card -->
      <view class="apply-card" bindtap="onTapApplyCard" hover-class="apply-card--hover">
        <view class="apply-card__icon">🛠</view>
        <view class="apply-card__info">
          <view class="apply-card__title">申请售后</view>
          <view class="apply-card__desc">提交退款 / 换货 / 申诉工单</view>
        </view>
        <view class="apply-card__arrow">›</view>
      </view>

      <!-- Contact button -->
      <view class="contact-btn" bindtap="onContactCs" hover-class="contact-btn--hover">联系客服 · 工作日 9:00-18:00</view>

      <!-- Section label + FAQ list -->
      <view class="section-label">常见问题</view>
      <view class="faq-list">
        <view
          wx:for="{{faqs}}"
          wx:key="id"
          class="faq-row"
          bindtap="onTapFaq"
          data-id="{{item.id}}"
          hover-class="faq-row--hover"
        >
          <text class="faq-row__q">{{item.q}}</text>
          <text class="faq-row__arrow">›</text>
        </view>
      </view>

      <!-- Footer (P0 组件化) -->
      <action-footer single="{{true}}">
        <view slot="primary">
          <button
            class="btn-primary"
            bindtap="onSubmit"
            disabled="{{true}}"
            hover-class="btn-primary--hover"
          >提交售后申请（未上线）</button>
        </view>
      </action-footer>
    </view>
  </block>

  <!-- mode=agreement -->
  <block wx:if="{{mode === 'agreement'}}">
    <view class="agreement">
      <view class="agreement__title">会员服务协议</view>
      <view class="agreement__body">
        <view wx:for="{{agreementSections}}" wx:key="id" class="agreement__section">
          <text class="agreement__h">{{item.h}}</text>
          <text class="agreement__p">{{item.body}}</text>
        </view>
        <view class="agreement__ellipsis">…</view>
      </view>
    </view>
  </block>
</view>