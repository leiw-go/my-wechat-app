/* P05 支付结果页 — high-fidelity (P0 组件化后)
 * 仅保留页面专属 result-block 样式（不在 P0 组件清单内）
 * action-footer / auth-code-card 样式已抽到 src/components/ */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 240rpx; /* 200rpx → 240rpx (action-footer 现约 220rpx 高 + 安全区) */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

.content {
  padding: 32rpx; /* 16rpx → 32rpx */
}

/* Result block — 4 态统一白卡（页面专属） */
.result-block {
  text-align: center;
  padding: 64rpx 32rpx 64rpx; /* 32rpx 16rpx → 64rpx 32rpx */
  background: #FFFFFF;
  border-radius: 32rpx; /* 16px → 32rpx */
  margin-bottom: 32rpx; /* 16px → 32rpx */
}

.result-circle {
  width: 144rpx; /* 72px → 144rpx */
  height: 144rpx;
  border-radius: 50%;
  margin: 16rpx auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-glyph {
  font-size: 80rpx; /* 40px → 80rpx */
  font-weight: 700;
  line-height: 1;
}

.result-title {
  font-size: 40rpx; /* 20rpx typo → 40rpx (HTML v3.2 .result-title 20px) */
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.result-desc {
  font-size: 28rpx; /* 14px → 28rpx */
  color: #4E5969;
  line-height: 1.5;
}

/* 4 态色卡 (page-specific; banner 组件只覆盖 card-style 提示，result-block 留页面) */
.result--success .result-circle { background: #E6F8E9; }
.result--success .result-glyph { color: #00B42A; }
.result--success { border-top: 6rpx solid #00B42A; }

.result--pending .result-circle { background: #FFF4E5; }
.result--pending .result-glyph { color: #FF7D00; }
.result--pending { border-top: 6rpx solid #FF7D00; }

.result--failed .result-circle { background: #FFECEC; }
.result--failed .result-glyph { color: #F53F3F; }
.result--failed { border-top: 6rpx solid #F53F3F; }

.result--unknown .result-circle { background: #F2F3F5; }
.result--unknown .result-glyph { color: #4E5969; }
.result--unknown { border-top: 6rpx solid #C9CDD4; }

/* Auth code card hint */
.auth-hint {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #86909C;
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.5;
}