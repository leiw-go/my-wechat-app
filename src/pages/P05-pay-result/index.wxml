<!-- P05 支付结果页 — PANR-19 C5 high-fidelity
     视觉对齐 issue 附件 p05-pay-result.html (v3 batch)
     4 个 result 态 (success/pending/failed/unknown):
       success: 绿圆 + ✓ + 支付成功 + 描述 + auth-card + 「查看订单详情」+ 「返回首页」
       pending: 橙圆 + ⏱ + 支付处理中 + 「我已支付」+ 「取消」
       failed:  红圆 + ✕ + 支付失败 + 「重试支付」+ 「联系客服」
       unknown: 灰圆 + ? + 订单状态未知 + （无 footer）
     payment-deferred 期间按钮点击 → toast「支付功能未启用」（与 5030 对齐） -->
<view class="page">
  <!--
    顶部 title 由 index.json 的 navigationBarTitleText "支付结果" 渲染为 WeChat
    系统导航栏；不在 WXML 内重复 .nav 块（dispatch R-011 §6 协议）。
  -->

  <view class="content">
    <!-- Result block — 4 态统一白卡 16rpx + 顶部 6rpx 状态条 -->
    <view class="result-block result--{{result}}">
      <view class="result-circle result-circle--{{result}}">
        <text class="result-glyph">{{glyph}}</text>
      </view>
      <view class="result-title">{{title}}</view>
      <view class="result-desc">{{desc}}</view>
    </view>

    <!-- Auth code card — 仅 success 态嵌入 -->
    <block wx:if="{{result === 'success'}}">
      <auth-code-card
        code="{{authCode}}"
        variant="default"
        copy-hint="授权码（点击复制）"
        bind:copy="onCopyAuthCode"
      />
      <view class="auth-hint">点击授权码可一键复制到剪贴板</view>
    </block>

    <!-- Footer actions — unknown 态无 footer -->
    <block wx:if="{{result !== 'unknown'}}">
      <view class="footer">
        <button class="btn-primary" bindtap="onPrimary" hover-class="btn-primary--hover">{{primaryLabel}}</button>
        <button class="btn-secondary" bindtap="onSecondary" hover-class="btn-secondary--hover">{{secondaryLabel}}</button>
      </view>
    </block>
  </view>
</view>