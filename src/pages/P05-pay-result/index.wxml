<!-- P05 支付结果页 — PANR-19 C5 high-fidelity (P0 组件化)
     重构后：
       - <auth-code-card> 已嵌（B1）—— 仅 success 态
       - <action-footer> 替代 inline .footer + .btn-primary + .btn-secondary
       - 4 result 态 .result-block / .result-circle / .result--success/pending/failed/unknown 保留（专属 UI；P05 result-block 不在 P0 组件清单内）
     系统 nav 由 index.json navigationBarTitleText "支付结果" 渲染 -->
<view class="page">
  <view class="content">
    <!-- Result block -->
    <view class="result-block result--{{result}}">
      <view class="result-circle result-circle--{{result}}">
        <text class="result-glyph">{{glyph}}</text>
      </view>
      <view class="result-title">{{title}}</view>
      <view class="result-desc">{{desc}}</view>
    </view>

    <!-- Auth code card (B1) — 仅 success 态嵌入 -->
    <block wx:if="{{result === 'success'}}">
      <auth-code-card
        code="{{authCode}}"
        variant="default"
        copy-hint="授权码（点击复制）"
        bind:copy="onCopyAuthCode"
      />
      <view class="auth-hint">点击授权码可一键复制到剪贴板</view>
    </block>

    <!-- Footer (unknown 态无 footer) -->
    <block wx:if="{{result !== 'unknown'}}">
      <action-footer single="{{false}}">
        <view slot="primary">
          <button class="btn-primary" bindtap="onPrimary" hover-class="btn-primary--hover">{{primaryLabel}}</button>
        </view>
        <view slot="secondary">
          <button class="btn-secondary" bindtap="onSecondary" hover-class="btn-secondary--hover">{{secondaryLabel}}</button>
        </view>
      </action-footer>
    </block>
  </view>
</view>