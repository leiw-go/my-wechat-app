<!-- P05 支付结果页 — PANR-19 C5 high-fidelity (P0 组件化 v2)
     4 个 result 态 (success/pending/failed/unknown):
       success: 绿圆 + ✓ + 支付成功 + 描述 + auth-card + 「查看订单详情」+ 「返回首页」
       pending: 橙圆 + ⏱ + 支付处理中 + 「我已支付」+ 「取消」
       failed:  红圆 + ✕ + 支付失败 + 「重试支付」+ 「联系客服」
       unknown: 灰圆 + ? + 订单状态未知 + （无 footer）
     2026-08-30 P04 CTA bug fix 同批次：
       - action-footer v2 (no slot) - 修复同款 slot style 隔离 bug
       - 4 态按钮文案按 query.result 切换 -->
<view class="page">
  <view class="content">
    <!-- Result block -->
    <view class="result-block result--{{result}}">
      <view class="result-circle result-circle--{{result}}">
        <text class="result-glyph">{{glyph}}</text>
      </view>
      <view class="result-title">{{title}}</view>
      <view class="result-desc">{{desc}}</view>
    </view>

    <!-- Auth code card (B1) — 仅 success 态嵌入 -->
    <block wx:if="{{result === 'success'}}">
      <auth-code-card
        code="{{authCode}}"
        variant="default"
        copy-hint="授权码（点击复制）"
        bind:copy="onCopyAuthCode"
      />
      <view class="auth-hint">点击授权码可一键复制到剪贴板</view>
    </block>

    <!-- Footer (v2 no slot) - unknown 态无 footer -->
    <block wx:if="{{result !== 'unknown'}}">
      <action-footer
        primary-label="{{primaryLabel}}"
        primary-disabled="{{false}}"
        secondary-label="{{secondaryLabel}}"
        secondary-disabled="{{false}}"
        bind:primary="onPrimary"
        bind:secondary="onSecondary"
      />
    </block>
  </view>
</view>