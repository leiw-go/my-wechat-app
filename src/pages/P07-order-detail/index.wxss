/* P07 订单详情页 — high-fidelity (P0 组件化后)
 * 移除 inline .header-card / .footer / .btn-primary / .btn-secondary（已抽组件）
 * 保留页面专属：error-block / status-card / info-block / history-row / section-label / empty-history */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 200rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

/* Error / empty state */
.error-block {
  background: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  padding: 60rpx 24rpx;
  margin: 60rpx 16rpx 0;
}

.error-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F2F3F5;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #C9CDD4;
  line-height: 96rpx;
}

.error-title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.error-desc {
  font-size: 13px;
  color: #86909C;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.btn-primary {
  display: inline-block;
  min-width: 140rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 24rpx;
  background: #1677FF;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 14px;
  font-weight: 500;
  margin: 0;
}

.btn-primary--hover {
  opacity: 0.85;
}

/* Loaded state */
.content {
  padding: 16rpx;
  box-sizing: border-box;
}

/* 1. 订单状态卡 */
.status-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  padding: 18rpx 16rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.status-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 12px;
  color: #86909C;
  line-height: 1.4;
}

.badge {
  font-size: 12px;
  font-weight: 500;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  line-height: 1.5;
}

.badge--blue { background: #E8F3FF; color: #1677FF; }
.badge--success { background: #E6F8E9; color: #00B42A; }
.badge--tertiary { background: #F2F3F5; color: #4E5969; }
.badge--warn { background: #FFF4E5; color: #FF7D00; }

.status-card__amount {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.amount-label {
  font-size: 13px;
  color: #4E5969;
}

.amount-value {
  font-size: 24px;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 0.5px;
}

/* 4. 订单信息区 */
.info-block {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  padding: 0 16rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row__label {
  color: #86909C;
  font-size: 13px;
}

.info-row__value {
  color: #1D2129;
  font-size: 13px;
  text-align: right;
  word-break: break-all;
}

.info-row__value--mono {
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-size: 12px;
  letter-spacing: 0.5px;
}

/* 5. 历史码区块 */
.section-label {
  font-size: 13px;
  color: #4E5969;
  font-weight: 500;
  margin: 16rpx 4rpx 8rpx;
}

.history-row {
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.history-row__code {
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-size: 12px;
  color: #4E5969;
  letter-spacing: 0.5px;
}

.history-row__time {
  font-size: 12px;
  color: #86909C;
}

.empty-history {
  background: #F2F3F5;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 13px;
  color: #86909C;
}

/* 6. Footer actions (action-footer slot 内 button) */
.btn-secondary {
  flex: 1;
  height: 44rpx;
  line-height: 44rpx;
  background: #FFFFFF;
  color: #4E5969;
  border: 1rpx solid #E5E6EB;
  border-radius: 16rpx;
  font-size: 14px;
  font-weight: 500;
  margin: 0;
}

.btn-secondary--hover {
  background: #F7F8FA;
}