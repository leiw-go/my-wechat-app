/* P06 我的订单页 — page-specific styles */

.page {
  padding: 0 0 48rpx 0;
}

.empty {
  margin: 80rpx 24rpx;
  text-align: center;
}

.empty__icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty__desc {
  font-size: 26rpx;
  color: #86909c;
}

.order {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.order__no {
  font-size: 26rpx;
  color: #86909c;
  margin-bottom: 8rpx;
}

.order__status {
  font-size: 28rpx;
  color: #1f2329;
}