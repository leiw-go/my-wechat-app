/* P06 我的订单页 — high-fidelity
 * 设计令牌：复用 P04 token（白底 / 16rpx 圆角 / #1677FF 主蓝 / #00B42A 成功绿）
 * 系统 nav 由 index.json navigationBarTitleText 提供；本文件不写 .nav 块
 */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 96rpx; /* 48rpx → 96rpx (页内 btn-primary 高度 ~88rpx + 安全区) */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

/* Tab bar */
.tab-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F1F3;
  padding: 0 32rpx; /* 16rpx → 32rpx */
  display: flex;
  gap: 48rpx; /* 24rpx → 48rpx */
  box-sizing: border-box;
}

.tab {
  font-size: 28rpx; /* 14px → 28rpx */
  color: #4E5969;
  padding: 28rpx 0 24rpx; /* 14rpx 0 12rpx → 28rpx 0 24rpx (满足 88rpx tap area) */
  position: relative;
}

.tab--active {
  color: #1677FF;
  font-weight: 600;
}

.tab--active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 48rpx; /* 24px → 48rpx */
  height: 6rpx; /* 3px → 6rpx */
  background: #1677FF;
  border-radius: 4rpx;
  transform: translateX(-50%);
}

/* Empty / Error state */
.empty {
  text-align: center;
  padding: 160rpx 48rpx; /* 80rpx 24rpx → 160rpx 48rpx */
}

.empty-icon {
  width: 192rpx; /* 96rpx → 192rpx */
  height: 192rpx;
  border-radius: 50%;
  background: #F2F3F5;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx; /* 40rpx → 80rpx */
  color: #C9CDD4;
  line-height: 192rpx;
}

.empty-title {
  font-size: 32rpx; /* 16px → 32rpx */
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx; /* 13px → 26rpx */
  color: #86909C;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.btn-primary {
  display: inline-block;
  min-width: 320rpx; /* 160rpx → 320rpx */
  height: 88rpx; /* 44px → 88rpx (满足 tap 标准) */
  line-height: 88rpx;
  padding: 0 48rpx;
  background: #1677FF;
  color: #FFFFFF;
  border: none;
  border-radius: 32rpx; /* 16rpx → 32rpx */
  font-size: 30rpx; /* 14px → 30rpx */
  font-weight: 500;
  letter-spacing: 1rpx;
  margin: 0;
}

.btn-primary--hover {
  opacity: 0.85;
}

/* List + order row */
.list {
  padding: 16rpx;
  box-sizing: border-box;
}

.order-row {
  background: #FFFFFF;
  border-radius: 32rpx; /* 16rpx → 32rpx */
  border: 1rpx solid #E5E6EB;
  padding: 32rpx; /* 16rpx → 32rpx */
  margin-bottom: 24rpx; /* 12rpx → 24rpx */
  box-sizing: border-box;
}

.order-row--hover {
  background: #F7F8FA;
}

.order-row__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx; /* 12rpx → 24rpx */
}

.order-no {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #86909C;
  line-height: 1.4;
}

.badge {
  font-size: 24rpx; /* 12px → 24rpx */
  font-weight: 500;
  padding: 4rpx 16rpx; /* 2rpx 10rpx → 4rpx 16rpx */
  border-radius: 8rpx; /* 4rpx → 8rpx */
  line-height: 1.5;
}

.badge--blue {
  background: #E8F3FF;
  color: #1677FF;
}

.badge--success {
  background: #E6F8E9;
  color: #00B42A;
}

.badge--tertiary {
  background: #F2F3F5;
  color: #4E5969;
}

.badge--warn {
  background: #FFF4E5;
  color: #FF7D00;
}

.order-row__body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-row__body .info {
  flex: 1;
  min-width: 0;
}

.order-row__body .name {
  font-size: 28rpx; /* 14px → 28rpx */
  font-weight: 500;
  line-height: 1.3;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.order-row__body .time {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #86909C;
  line-height: 1.4;
}

.order-row__body .amount {
  font-size: 32rpx; /* 16px → 32rpx */
  font-weight: 600;
  color: #1D2129;
  flex-shrink: 0;
  margin-left: 24rpx;
}