/* P06 我的订单页 — high-fidelity
 * 设计令牌：复用 P04 token（白底 / 16rpx 圆角 / #1677FF 主蓝 / #00B42A 成功绿）
 * 系统 nav 由 index.json navigationBarTitleText 提供；本文件不写 .nav 块
 */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 48rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

/* Tab bar */
.tab-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F1F3;
  padding: 0 16rpx;
  display: flex;
  gap: 24rpx;
  box-sizing: border-box;
}

.tab {
  font-size: 14px;
  color: #4E5969;
  padding: 14rpx 0 12rpx;
  position: relative;
}

.tab--active {
  color: #1677FF;
  font-weight: 600;
}

.tab--active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 24rpx;
  height: 3rpx;
  background: #1677FF;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

/* Empty / Error state */
.empty {
  text-align: center;
  padding: 80rpx 24rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F2F3F5;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #C9CDD4;
  line-height: 96rpx;
}

.empty-title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.empty-desc {
  font-size: 13px;
  color: #86909C;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.btn-primary {
  display: inline-block;
  min-width: 160rpx;
  height: 44px;
  line-height: 44px;
  padding: 0 24rpx;
  background: #1677FF;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.5px;
  margin: 0;
}

.btn-primary--hover {
  opacity: 0.85;
}

/* List + order row */
.list {
  padding: 16rpx;
  box-sizing: border-box;
}

.order-row {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.order-row--hover {
  background: #F7F8FA;
}

.order-row__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 12px;
  color: #86909C;
  line-height: 1.4;
}

.badge {
  font-size: 12px;
  font-weight: 500;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  line-height: 1.5;
}

.badge--blue {
  background: #E8F3FF;
  color: #1677FF;
}

.badge--success {
  background: #E6F8E9;
  color: #00B42A;
}

.badge--tertiary {
  background: #F2F3F5;
  color: #4E5969;
}

.badge--warn {
  background: #FFF4E5;
  color: #FF7D00;
}

.order-row__body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-row__body .info {
  flex: 1;
  min-width: 0;
}

.order-row__body .name {
  font-size: 14px;
  font-weight: 500;
  line-height: 1.3;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.order-row__body .time {
  font-size: 12px;
  color: #86909C;
  line-height: 1.4;
}

.order-row__body .amount {
  font-size: 16px;
  font-weight: 600;
  color: #1D2129;
  flex-shrink: 0;
  margin-left: 12rpx;
}