<!-- P06 我的订单页 — PANR-19 C5 high-fidelity
     视觉对齐 issue 附件 p06-my-orders.html (v3 batch)
     3 tabs: 全部 / 进行中 / 已完成
     空态默认展示（payment-deferred 期间无订单）；有订单时渲染 order-row 列表
     系统 nav 由 index.json navigationBarTitleText 提供 -->
<view class="page">
  <!-- Tab bar -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{currentTab === item.key ? 'tab--active' : ''}}"
      bindtap="onSwitchTab"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <!-- Empty state -->
  <view wx:if="{{loadState === 'empty'}}" class="empty">
    <view class="empty-icon">📋</view>
    <view class="empty-title">暂无订单</view>
    <view class="empty-desc">去看看有哪些小程序可以购买</view>
    <button class="btn-primary" bindtap="onBrowseGoods" hover-class="btn-primary--hover">浏览商品</button>
  </view>

  <!-- Error state -->
  <view wx:elif="{{loadState === 'error'}}" class="empty">
    <view class="empty-icon">⚠</view>
    <view class="empty-title">加载失败</view>
    <view class="empty-desc">请检查网络后重试</view>
    <button class="btn-primary" bindtap="onRetry" hover-class="btn-primary--hover">重新加载</button>
  </view>

  <!-- Loaded state -->
  <view wx:else class="list">
    <view
      wx:for="{{orders}}"
      wx:key="orderNo"
      class="order-row"
      bindtap="onTapOrder"
      data-order-no="{{item.orderNo}}"
      hover-class="order-row--hover"
    >
      <view class="order-row__head">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="badge badge--{{item.statusType}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-row__body">
        <view class="info">
          <view class="name">{{item.goodsName}}</view>
          <view class="time">{{item.paidAt}} · {{item.payChannel}}</view>
        </view>
        <view class="amount">¥{{item.amount}}</view>
      </view>
    </view>
  </view>
</view>