<!-- P11 续费下单页 — PANR-19 C5 high-fidelity (P0 组件化)
     与 P04 95% 相似，复用同一套 P0 组件 + 调整 3 处：
       - subtitle-tone=\"warn\" (到期时间橙) vs P04 \"gray\"
       - banner tone=\"info\" 蓝调 vs P04 \"warn\" 橙
       - selectedTier 默认 'L' vs P04 'M'
     系统 nav 由 index.json navigationBarTitleText \"续费\" 渲染 -->
<view class="page">
  <view class="content">
    <!-- Header card (到期时间 → subtitle-tone=warn) -->
    <goods-header-card
      name="{{goodsName}}"
      subtitle="{{expireLabel}}"
      subtitle-tone="warn"
    />

    <!-- Section label -->
    <view class="section-label">选择续费档位</view>

    <!-- Tier list (默认 L 选中) -->
    <tier-list
      tiers="{{tiers}}"
      selected-code="{{selectedTier}}"
      bind:select="onTapTier"
    />

    <!-- Banner: Info 蓝调 -->
    <banner tone="info" text="{{bannerText}}" />

    <!-- Agreement row -->
    <agreement-row
      checked="{{agreed}}"
      text="我已阅读并同意"
      link-text="《会员服务协议》"
      bind:change="onAgreementChange"
    />

    <!-- Footer -->
    <action-footer single="{{true}}">
      <view slot="primary">
        <button
          class="btn-primary {{agreed ? 'btn-primary--agreed' : ''}}"
          disabled="{{true}}"
          bindtap="onSubmit"
        >续费下单（未上线）</button>
      </view>
    </action-footer>
  </view>
</view>