<!-- P11 续费下单页 — PANR-19 C5 high-fidelity (P0 组件化 v2)
     与 P04 95% 相似，套同一套 P0 组件 + 调整 3 处：
       - subtitle-tone=\"warn\" (到期时间橙)
       - banner tone=\"info\" 蓝调
       - selectedTier 默认 'L'
     2026-08-30 P04 CTA bug fix 同批次：
       - action-footer v2 (no slot, 内部渲染 button) - 修复同款 slot style 隔离 bug
       - CTA 文案「续费下单 · 支付暂未上线」(purchase CTA 跟 PM 规格)
     系统 nav 由 index.json navigationBarTitleText "续费" 渲染 -->
<view class="page">
  <view class="content">
    <!-- Header card -->
    <goods-header-card
      name="{{goodsName}}"
      subtitle="{{expireLabel}}"
      subtitle-tone="warn"
    />

    <!-- Section label -->
    <view class="section-label">选择续费档位</view>

    <!-- Tier list -->
    <tier-list
      tiers="{{tiers}}"
      selected-code="{{selectedTier}}"
      bind:select="onTapTier"
    />

    <!-- Banner: Info 蓝调 -->
    <banner tone="info" text="{{bannerText}}" />

    <!-- Agreement row -->
    <agreement-row
      checked="{{agreed}}"
      text="我已阅读并同意"
      link-text="《会员服务协议》"
      bind:change="onAgreementChange"
    />

    <!-- Footer (v2 no slot) -->
    <action-footer
      primary-label="续费下单 · 支付暂未上线"
      primary-disabled="{{true}}"
      bind:primary="onPrimary"
    />
  </view>
</view>