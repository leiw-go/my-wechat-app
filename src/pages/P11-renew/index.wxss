/* P11 续费下单页 — high-fidelity
 * 与 P04 90% 复用：共用 .page / .content / .header-card / .section-label /
 * .tier-list / .tier-row / .agreement / .footer / .btn-primary 块
 * P11 独有的差异：
 *   1. .header-card .subtitle 橙色 (到期时间 vs P04 商品副标灰)
 *   2. .banner--info 蓝调 (vs P04 .banner.warn 橙)
 * 系统 nav 由 index.json navigationBarTitleText 提供
 */

.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 140rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: #1D2129;
}

.content {
  padding: 4px 16px 16px;
}

/* Header card — 复用 P04 */
.header-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  border: 1rpx solid #E5E6EB;
}

.header-card .cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #1677FF 0%, #0A47A0 100%);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.header-card .cover::after {
  content: "SaaS";
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.header-card .info {
  flex: 1;
  min-width: 0;
}

.header-card .name {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.header-card .subtitle {
  font-size: 12px;
  color: #86909C;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* P11 差异 1: 副标橙色 (到期时间 vs P04 商品副标灰) */
.header-card .subtitle--expire {
  color: #FF7D00;
}

/* Section label */
.section-label {
  font-size: 13px;
  color: #4E5969;
  font-weight: 500;
  margin: 16rpx 4rpx 8rpx;
}

/* Tier list — 完全复用 P04 */
.tier-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  overflow: hidden;
}

.tier-row {
  height: 64rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.tier-row:last-child {
  border-bottom: none;
}

.tier-row.selected {
  background: #F0F5FF;
  box-shadow: inset 3rpx 0 0 #1677FF;
  padding-left: 11rpx;
}

.tier-row .badge {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: #F2F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  color: #4E5969;
  flex-shrink: 0;
}

.tier-row.selected .badge {
  background: #1677FF;
  color: #FFFFFF;
}

.tier-row .meta {
  flex: 1;
  min-width: 0;
}

.tier-row .name {
  font-size: 14px;
  font-weight: 500;
  line-height: 1.3;
}

.tier-row .duration {
  font-size: 12px;
  color: #86909C;
  margin-top: 2rpx;
}

.tier-row .price {
  font-size: 15px;
  font-weight: 600;
  color: #1D2129;
  flex-shrink: 0;
}

.tier-row .check {
  width: 18rpx;
  height: 18rpx;
  border: 1.5rpx solid #C9CDD4;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}

.tier-row.selected .check {
  border-color: #1677FF;
  background: #1677FF;
}

.tier-row.selected .check::after {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 1rpx;
  width: 5rpx;
  height: 9rpx;
  border: solid #FFFFFF;
  border-width: 0 1.5rpx 1.5rpx 0;
  transform: rotate(45deg);
}

/* Banner — Info 蓝调 (vs P04 .banner.warn 橙) */
.banner {
  margin-top: 12rpx;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.banner--info {
  background: #E8F3FF;
}

.banner--info .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1677FF;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.banner--info .text {
  font-size: 13px;
  color: #1677FF;
  line-height: 1.5;
}

/* Agreement row — 复用 P04 */
.agreement {
  margin-top: 8rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 4rpx;
}

.checkbox {
  width: 18rpx;
  height: 18rpx;
  border: 1.5rpx solid #C9CDD4;
  border-radius: 4rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  border-color: #1677FF;
  background: #1677FF;
}

.checkbox__mark {
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
}

.agreement .text {
  font-size: 13px;
  color: #4E5969;
  line-height: 1.4;
}

.agreement .text .link {
  color: #1677FF;
}

/* Footer */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 16rpx 28rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F1F3;
}

.btn-primary {
  width: 100%;
  height: 48rpx;
  background: #E5E6EB;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.5px;
  line-height: 48rpx;
}

.btn-primary[disabled] {
  background: #E5E6EB;
  color: #FFFFFF;
}