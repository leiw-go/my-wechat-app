/* tier-list — ADR-007 §三 token 落地
 * bg-card #FFFFFF / border-1 #E5E6EB / radius-card 16rpx
 * tier-row 64h + border-3 #F2F3F5 divider
 * selected 态：bg-tint #F0F5FF + inset 3rpx 蓝条 #1677FF
 * badge 32×32 (selected 蓝底白字 / default #F2F3F5 底 + #4E5969 字)
 * price 15/600 #1D2129
 * check 18×18 (selected #1677FF 蓝圆 + 白勾 / default 灰边) */

.tier-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
  overflow: hidden;
}

.tier-row {
  height: 128rpx; /* HTML v3.2 .tier-row 64px → 128rpx (375px 屏) */
  padding: 0 28rpx; /* 14px → 28rpx */
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px → 24rpx */
  border-bottom: 1rpx solid #F2F3F5;
}

.tier-row:last-child {
  border-bottom: none;
}

.tier-row--hover {
  background: #F7F8FA;
}

.tier-row--selected {
  background: #F0F5FF;
  box-shadow: inset 6rpx 0 0 #1677FF; /* 3px → 6rpx */
  padding-left: 22rpx; /* 11px → 22rpx */
}

.tier-row__badge {
  width: 64rpx; /* 32px → 64rpx (HTML v3.2) */
  height: 64rpx;
  border-radius: 16rpx; /* 8px → 16rpx */
  background: #F2F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx; /* 13px → 26rpx */
  font-weight: 600;
  color: #4E5969;
  flex-shrink: 0;
}

.tier-row--selected .tier-row__badge {
  background: #1677FF;
  color: #FFFFFF;
}

.tier-row__meta {
  flex: 1;
  min-width: 0;
}

.tier-row__name {
  font-size: 28rpx; /* 14px → 28rpx (HTML v3.2) */
  font-weight: 500;
  line-height: 1.3;
  color: #1D2129;
}

.tier-row__duration {
  font-size: 24rpx; /* 12px → 24rpx (HTML v3.2) */
  color: #86909C;
  margin-top: 4rpx;
  line-height: 1.4;
}

.tier-row__price {
  font-size: 30rpx; /* 15px → 30rpx (HTML v3.2) */
  font-weight: 600;
  color: #1D2129;
  flex-shrink: 0;
}

.tier-row__check {
  width: 36rpx; /* 18px → 36rpx (HTML v3.2) */
  height: 36rpx;
  border: 2rpx solid #C9CDD4; /* 1.5px → 2rpx (可视) */
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  box-sizing: border-box;
}

.tier-row--selected .tier-row__check {
  border-color: #1677FF;
  background: #1677FF;
}

.tier-row--selected .tier-row__check::after {
  content: "";
  position: absolute;
  left: 12rpx; /* 4px → 12rpx */
  top: 4rpx; /* 1px → 4rpx */
  width: 10rpx; /* 5px → 10rpx */
  height: 18rpx; /* 9px → 18rpx */
  border: solid #FFFFFF;
  border-width: 0 4rpx 4rpx 0; /* 1.5px → 4rpx (可视) */
  transform: rotate(45deg);
}