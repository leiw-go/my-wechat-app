/* banner 组件 — ADR-007 §三 token 落地
 * 12rpx radius / 12rpx~14rpx padding / 10rpx gap
 * 4 色调色板 (P04 .banner.warn / p11-renew .banner--info 参考) */

.banner {
  margin-top: 12rpx;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  box-sizing: border-box;
}

.banner__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.banner__text {
  font-size: 13px;
  line-height: 1.5;
  flex: 1;
  word-break: break-all;
}

/* info */
.banner--info {
  background: #E8F3FF;
}
.banner--info .banner__dot {
  background: #1677FF;
}
.banner--info .banner__text {
  color: #1677FF;
}

/* warn */
.banner--warn {
  background: #FFF4E5;
}
.banner--warn .banner__dot {
  background: #FF7D00;
}
.banner--warn .banner__text {
  color: #FF7D00;
}

/* success */
.banner--success {
  background: #E6F8E9;
}
.banner--success .banner__dot {
  background: #00B42A;
}
.banner--success .banner__text {
  color: #00B42A;
}

/* error */
.banner--error {
  background: #FFECEC;
}
.banner--error .banner__dot {
  background: #F53F3F;
}
.banner--error .banner__text {
  color: #F53F3F;
}