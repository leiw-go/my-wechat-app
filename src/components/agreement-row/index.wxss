/* agreement-row — ADR-007 §三 token 落地
 * checkbox 18×18 + 1.5rpx #C9CDD4 边 / checked #1677FF 蓝底
 * text 13px / link #1677FF */

.agreement-row {
  min-height: 96rpx; /* HTML v3.2 .agreement 48px → 96rpx (375px 屏); 满足 88rpx tap 标准 */
  display: flex;
  align-items: center;
  gap: 20rpx; /* HTML v3.2 10px → 20rpx */
  padding: 16rpx 8rpx; /* HTML v3.2 8px 4px → 16rpx 8rpx */
  box-sizing: border-box;
}

.agreement-row__checkbox {
  width: 36rpx; /* HTML v3.2 .checkbox 18px → 36rpx */
  height: 36rpx;
  border: 2rpx solid #C9CDD4; /* HTML v3.2 1.5px → 2rpx (可视) */
  border-radius: 8rpx; /* HTML v3.2 4px → 8rpx */
  flex-shrink: 0;
  background: #FFFFFF;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.agreement-row__checkbox--checked {
  border-color: #1677FF;
  background: #1677FF;
}

.agreement-row__mark {
  color: #FFFFFF;
  font-size: 24rpx; /* 12px → 24rpx */
  font-weight: 700;
  line-height: 1;
}

.agreement-row__text {
  font-size: 26rpx; /* 13px → 26rpx */
  color: #4E5969;
  line-height: 1.4;
}

.agreement-row__link {
  color: #1677FF;
}