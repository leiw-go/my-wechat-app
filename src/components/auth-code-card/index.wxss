/* auth-code-card 组件样式 — 对齐 auth-code-card.html (v3)
 * 设计令牌复用 P04 token：
 *   - 白底 #FFFFFF / 边框 #E5E6EB / 圆角 16rpx
 *   - 主蓝 #1677FF / 成功绿 #00B42A / 失效灰 #C9CDD4
 *   - 字体 PingFang SC + monospace (SF Mono / Menlo / Consolas)
 */

/* Block — base */
.auth-card {
  background: #FFFFFF;
  border-radius: 32rpx; /* HTML v3.2 16px → 32rpx */
  padding: 36rpx 32rpx; /* HTML v3.2 18px 16px → 36rpx 32rpx */
  border: 1rpx solid #E5E6EB;
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.auth-card .auth-label {
  font-size: 24rpx; /* 12px → 24rpx */
  color: #86909C;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  line-height: 1.4;
}

.auth-card .auth-label .label-text {
  color: #86909C;
  font-size: 24rpx;
}

.auth-card .auth-label .copy {
  color: #1677FF;
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx; /* 4px → 8rpx */
  font-weight: 500;
  padding: 8rpx 12rpx; /* 扩大点击热区到 ≥ 88rpx */
  margin: -8rpx -12rpx; /* 视觉补偿 */
}

.auth-card .auth-label .copy::before {
  content: "⎘";
  font-size: 28rpx; /* 14px → 28rpx */
}

.auth-card .auth-label .copy--hover {
  opacity: 0.6;
}

.auth-card .auth-label .copy--disabled {
  color: #C9CDD4;
  pointer-events: none;
}

.auth-card .auth-label .copy--hidden {
  visibility: hidden;
}

.auth-card .auth-code {
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-size: 36rpx; /* 18px → 36rpx (HTML v3.2 鉴权码 18px) */
  color: #1D2129;
  background: #F7F8FA;
  padding: 28rpx 24rpx; /* 14rpx 12rpx → 28rpx 24rpx */
  border-radius: 24rpx; /* 12px → 24rpx */
  text-align: center;
  letter-spacing: 1rpx;
  line-height: 1.4;
  word-break: break-all;
}

/* Variant: copied */
.auth-card--copied .auth-label .state {
  color: #00B42A;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-weight: 500;
}

.auth-card--copied .auth-label .state__dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx; /* 16px → 32rpx */
  height: 32rpx;
  border-radius: 50%;
  background: #00B42A;
  color: #FFFFFF;
  font-size: 20rpx; /* 10px → 20rpx */
  font-weight: 700;
  line-height: 1;
  margin-right: 4rpx;
}

.auth-card--copied .auth-code {
  background: #E6F8E9;
  color: #00B42A;
}

/* Variant: expired */
.auth-card--expired {
  background: #F2F3F5;
  border-color: #E5E6EB;
}

.auth-card--expired .auth-label {
  color: #86909C;
}

.auth-card--expired .auth-code {
  background: #FFFFFF;
  color: #86909C;
  text-decoration: line-through;
  text-decoration-color: #C9CDD4;
  text-decoration-thickness: 1.5px;
}

.auth-card--expired .auth-overlay {
  position: relative;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx dashed #C9CDD4;
  border-radius: 20rpx;
  text-align: center;
  font-size: 24rpx; /* 12px → 24rpx */
  color: #4E5969;
  line-height: 1.5;
  box-sizing: border-box;
}

.auth-card--expired .auth-overlay .overlay-text {
  display: block;
  margin-bottom: 12rpx;
}

.auth-card--expired .auth-overlay .btn-mini {
  display: inline-block;
  padding: 16rpx 32rpx; /* 扩到 88rpx tap area (含 line-height) */
  background: #1677FF;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 26rpx; /* 12px → 26rpx */
  font-weight: 500;
  line-height: 1.5;
  min-height: 64rpx; /* 视觉补偿 tap 热区 */
  box-sizing: border-box;
}

.auth-card--expired .auth-overlay .btn-mini:active {
  opacity: 0.85;
}