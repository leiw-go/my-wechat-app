/* action-footer — PANR-19 C5 P0 组件 (ADR-007 §二 #5)
 *
 * 设计令牌（PM 2026-08-30 视觉规格；偏离 ADR-007 §三 baseline 待 ADR-007 v2.1 裁定）：
 *   - 固定底部 / bg-card #FFFFFF / 顶部 border-2 #F0F1F3 (1px 浅灰分隔线)
 *   - padding 14rpx 16rpx 28rpx
 *   - 主按钮 (active): bg #FF7A45 (token accent/primary ⚠ 偏离 baseline #FF7D00)
 *                     圆角 12rpx (⚠ 偏离 baseline 16rpx)
 *                     字 17/600 白字 (⚠ 偏离 baseline 15/500)
 *                     高度 48rpx
 *   - 主按钮 (disabled): bg #E5E6EB + 字 #FFFFFF (灰底白字)
 *   - 次按钮 (active): bg #FFFFFF / 边 #E5E6EB / 字 #4E5969 / 高 44rpx
 *   - 次按钮 (disabled): bg #F2F3F5 + 字 #C9CDD4
 */

.action-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 16rpx 28rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F1F3;
  box-sizing: border-box;
  z-index: 100;
}

.action-footer--no-border {
  border-top: none;
}

/* 主按钮 — active 态 (橙色 #FF7A45 ⚠ token 偏离 baseline) */
.action-footer__primary-btn {
  width: 100%;
  height: 48rpx;
  background: #FF7A45; /* ⚠ token 偏离 ADR-007 §三 baseline #FF7D00 */
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx; /* ⚠ 偏离 baseline 16rpx */
  font-size: 17px; /* ⚠ 偏离 baseline 15px */
  font-weight: 600; /* ⚠ 偏离 baseline 500 */
  letter-spacing: 0.5px;
  line-height: 48rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.action-footer__primary-btn--disabled {
  background: #E5E6EB;
  color: #FFFFFF;
}

.action-footer__primary-btn--hover {
  opacity: 0.85;
}

/* 次按钮 */
.action-footer__secondary-btn {
  width: 100%;
  height: 44rpx;
  background: #FFFFFF;
  color: #4E5969;
  border: 1rpx solid #E5E6EB;
  border-radius: 12rpx; /* ⚠ 偏离 baseline 16rpx（次按钮同样按 PM 规格） */
  font-size: 14px;
  font-weight: 500;
  line-height: 44rpx;
  margin: 12rpx 0 0;
  padding: 0;
  box-sizing: border-box;
}

.action-footer__secondary-btn--disabled {
  background: #F2F3F5;
  color: #C9CDD4;
  border-color: #F2F3F5;
}

.action-footer__secondary-btn--hover {
  background: #F7F8FA;
}