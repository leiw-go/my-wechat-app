/* action-footer — PANR-19 C5 P0 组件 (ADR-007 §二 #5 + ADR-007 v2.1)
 *
 * 设计令牌（v2.1 final — UI 设计师 + 架构师双签 2026-08-30）：
 *   - 固定底部 / bg-card #FFFFFF / 顶部 border-2 #F0F1F3 (1px 浅灰分隔线)
 *   - padding 14rpx 16rpx 28rpx
 *   - 主按钮 (active): bg accent/primary #FF7A45
 *                     radius accent/primary-radius 12rpx
 *                     type accent/primary-type 17px / 600
 *                     高度 48rpx
 *   - 主按钮 (disabled): bg #E5E6EB + 字 #FFFFFF (灰底白字)
 *   - 次按钮 (active): bg #FFFFFF / 边 #E5E6EB / 字 #4E5969 / 高 44rpx
 *                     radius 12rpx (与主 CTA 一致)
 *   - 次按钮 (disabled): bg #F2F3F5 + 字 #C9CDD4
 *
 * v2.1 三轨 token 框架（架构师命名空间策略）：
 *   - accent/primary       基础层·行动色 (CTA active)
 *   - warn / brand          基础层·提示色 / 品牌色（保留）
 *   - btn-primary / btn-secondary  组件层·角色（保留）
 *
 * 扩展钩子（v2.x 预留，本期未实现）：
 *   - accent/primary-hover / -press / -disabled
 */

.action-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 16rpx 28rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F1F3;
  box-sizing: border-box;
  z-index: 100;
}

.action-footer--no-border {
  border-top: none;
}

/* 主按钮 — active 态 (token accent/primary) */
.action-footer__primary-btn {
  width: 100%;
  height: 48rpx;
  background: #FF7A45; /* accent/primary */
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx; /* accent/primary-radius */
  font-size: 17px; /* accent/primary-type 字 */
  font-weight: 600; /* accent/primary-type 字重 */
  letter-spacing: 0.5px;
  line-height: 48rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.action-footer__primary-btn--disabled {
  background: #E5E6EB;
  color: #FFFFFF;
}

.action-footer__primary-btn--hover {
  opacity: 0.85;
}

/* 次按钮 — 与主 CTA 同 12rpx 圆角（v2.1 一致规格） */
.action-footer__secondary-btn {
  width: 100%;
  height: 44rpx;
  background: #FFFFFF;
  color: #4E5969;
  border: 1rpx solid #E5E6EB;
  border-radius: 12rpx;
  font-size: 14px;
  font-weight: 500;
  line-height: 44rpx;
  margin: 12rpx 0 0;
  padding: 0;
  box-sizing: border-box;
}

.action-footer__secondary-btn--disabled {
  background: #F2F3F5;
  color: #C9CDD4;
  border-color: #F2F3F5;
}

.action-footer__secondary-btn--hover {
  background: #F7F8FA;
}