/* action-footer — ADR-007 §三 token 落地
 * 固定底部 / bg-card #FFFFFF / 顶部 border-2 #F0F1F3 / padding 14rpx 16rpx 28rpx
 * 主按钮 48rpx / 次按钮 44rpx / 间距 12rpx */

.action-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 16rpx 28rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F1F3;
  box-sizing: border-box;
}

.action-footer--no-border {
  border-top: none;
}

.action-footer__primary {
  width: 100%;
}

.action-footer__secondary {
  width: 100%;
  margin-top: 12rpx;
}

/* 默认主按钮样式（如果父页面没有自定义 button class） */
.action-footer__primary > button,
.action-footer__secondary > button {
  width: 100%;
  height: 48rpx;
  background: #E5E6EB;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.5px;
  line-height: 48rpx;
  margin: 0;
  padding: 0;
}

.action-footer__secondary > button {
  height: 44rpx;
  line-height: 44rpx;
  background: #FFFFFF;
  color: #4E5969;
  border: 1rpx solid #E5E6EB;
  font-size: 14px;
}