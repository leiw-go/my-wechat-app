/* goods-header-card — ADR-007 §三 token 落地
 * bg-card #FFFFFF / border-1 #E5E6EB / radius-card 16rpx
 * cover 72×72 + 12rpx radius + #1677FF→#0A47A0 渐变 (SaaS 占位)
 * name 16/600 #1D2129 / subtitle 12/400 (gray #86909C | warn #FF7D00) */

.goods-header-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  border: 1rpx solid #E5E6EB;
  box-sizing: border-box;
}

.goods-header-card__cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #1677FF 0%, #0A47A0 100%);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.goods-header-card__info {
  flex: 1;
  min-width: 0;
}

.goods-header-card__name {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 4rpx;
  word-break: break-all;
  color: #1D2129;
}

.goods-header-card__subtitle {
  font-size: 12px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-header-card__subtitle--gray {
  color: #86909C;
}

.goods-header-card__subtitle--warn {
  color: #FF7D00;
}