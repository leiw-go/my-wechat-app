# ===== 应用 =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=panr
DB_PASS=panr_dev_pwd
DB_NAME=panr_saas

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ===== JWT =====
# HS256 secret (dev 用, prod 必须 KMS)
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_prod
JWT_ACCESS_TTL=7200          # 2h
JWT_REFRESH_TTL=604800       # 7d

# ===== 微信小程序 =====
WX_APP_ID=wx_dev_app_id
WX_APP_SECRET=wx_dev_secret
WX_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ===== 微信支付 V3 =====
WX_PAY_MCH_ID=1600000000
WX_PAY_API_V3_KEY=dev_32_byte_v3_key_xxxxxxxxxxxxxxxxx
WX_PAY_CERT_SERIAL_NO=xxx
WX_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_PAY_NOTIFY_URL=https://dev-api.example.com/api/pay/notify

# ===== KMS (dev/staging 用 env, prod 必须切 KMS) =====
KMS_MODE=env                # env | kms
KMS_PHONE_KEY=dev_phone_encryption_key_xxxxxxxx
KMS_PROVIDER=aliyun         # 预留 aliyun / tencent / aws

# ===== 限流 =====
RATE_LIMIT_USER=60          # 每用户 60 req/min
RATE_LIMIT_IP=600           # 每 IP 600 req/min

# ===== 业务 =====
AUTH_CODE_REPLACE_BUFFER_DAYS=7
ORDER_PAY_TIMEOUT_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24
