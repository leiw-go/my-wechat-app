# ===== Frontend env (PANR-19 C5) =====
# 拷贝为 .env 后按需覆盖；.env 已被 .gitignore 忽略，禁止入库。

# 后端 API baseURL — PM 二次拍板 Option B'
# 外网入口走 nginx 反代：/panr-api/* → http://127.0.0.1:3000/*
# 严禁再回到 http://43.143.244.13:3000/api（外网 3000 端口云安全组拦截，已确认）
VITE_API_BASE_URL=https://yaowen.store/panr-api

# 测试环境 AppID — 走业务方 wxde0c66d012c15d87，未走 ICP 业务域名流程
# 微信开发者工具必须勾选「不校验合法域名」
VITE_WX_APPID=wxde0c66d012c15d87

# 构建模式 — test / prod（test 走外网 + 占位；prod 不在本迭代范围）
VITE_BUILD_MODE=test
